# Python venv — 镜像中由 uv sync 创建，不要从宿主机覆盖
.venv

# Python 缓存
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache

# IDE
.idea
.vscode
*.swp
*.swo

# Git
.git
.gitignore

# 环境文件（通过 docker-compose env_file 注入）
.env
.env.*
!.env.example

# 运行时数据
storage/
uploads/
logs/

# 日志
*.log

# 文档
*.md
README*
LICENSE
!CLAUDE.md
docs/

# 测试和脚本
tests/
scripts/

# Docker 配置
.dockerignore
Dockerfile
docker-compose*.yml
