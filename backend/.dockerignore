# Python venv — 镜像中由 uv sync 创建，不要从宿主机覆盖
.venv

# Python 缓存
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache

# IDE
.idea
.vscode
*.swp
*.swo

# Git
.git
.gitignore

# 环境文件（通过 docker-compose env_file 注入）
.env
.env.*
!.env.example

# 运行时数据
storage/
uploads/
logs/

# 日志
*.log

# 文档
*.md
README*
LICENSE
!CLAUDE.md
docs/

# 测试和脚本
tests/
scripts/

# 例外：构建期脚本必须进镜像（Dockerfile.worker 会 COPY 它们）
# worker 用它装 spaCy 英文模型、预下载并校验 TTS 权重，缺了构建直接失败
!scripts/ci/install_spacy_en_model.py
!scripts/ci/preload_tts_models.py

# Docker 配置
.dockerignore
Dockerfile
docker-compose*.yml
