# CI environment configuration — copy to .env.ci for local CI testing
# GitHub Actions defines these inline; this file is for local `bash scripts/ci.sh full`
APP_ENV=ci
APP_NAME=dazah-backend

# Database - use separate CI database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dazah_ci

# Redis
REDIS_URL=redis://localhost:6379/0

# Application settings
SECRET_KEY=ci-test-secret-key-not-for-production
DEBUG=false

# Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Feishu Platform (nested config using __ delimiter)
FEISHU__PLATFORM__APP_ID=ci_dummy_app_id
FEISHU__PLATFORM__APP_SECRET=ci_dummy_app_secret
FEISHU__PLATFORM__REDIRECT_URI=http://localhost:3000/callback
FRONTEND_URL=http://localhost:3000

# JWT
JWT_EXPIRE_SECONDS=86400

# LLM - disabled in CI
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
