# App
APP_NAME=dazah-backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
# Optional Fernet key for encrypting secrets stored in DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dazah
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dazah
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Docker app container only.
# Keep DATABASE_URL/REDIS_URL on localhost for local Windows development.
# The Compose app profile uses these container-network URLs instead.
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/dazah
APP_REDIS_URL=redis://redis:6379/0

# Audit
AUDIT_RETENTION_DAYS=7

# Feishu (Lark) - platform app shared by SSO, org sync, IM and common Bitable access.
FEISHU__PLATFORM__APP_ID=cli_xxx
FEISHU__PLATFORM__APP_SECRET=your_feishu_app_secret
FEISHU__PLATFORM__REDIRECT_URI=http://localhost:8000/api/v1/identity/auth/callback
FEISHU__PLATFORM__SCOPES=contact:contact.base:readonly contact:user.base:readonly
FRONTEND_URL=http://localhost:3000
FEISHU__PLATFORM__WS_ENABLED=true

# Feishu org sync / common chat targets.
FEISHU__PLATFORM__SYNC_ROOT_DEPT_ID=
FEISHU__PLATFORM__SYNC_MEMBER_DEPT_ID=
FEISHU__PLATFORM__EQUIPMENT_DEPT_ID=
FEISHU__PLATFORM__EQUIPMENT_CHAT_ID=
FEISHU__PLATFORM__SAFETY_CHAT_ID=

# Feishu Bitable - HR module.
FEISHU__HR_BITABLE__APP_TOKEN=base_or_wiki_converted_app_token
FEISHU__HR_BITABLE__EMPLOYEE_TABLE_ID=tblEmployee
FEISHU__HR_BITABLE__DEPARTMENT_TABLE_ID=tblDepartment
FEISHU__HR_BITABLE__OFFBOARDING_TABLE_ID=tblOffboarding
FEISHU__HR_BITABLE__ONBOARDING_TABLE_ID=tblOnboarding
FEISHU__HR_BITABLE__DEPARTURE_TABLE_ID=tblDeparture
FEISHU__HR_BITABLE__APPROVAL_TABLE_ID=tblApproval

# Feishu Bitable - product module.
FEISHU__PRODUCT__BITABLE_APP_TOKEN=
FEISHU__PRODUCT__BITABLE_TABLE_ID=

# Feishu AI Query
FEISHU__AI_QUERY__TABLES={}
FEISHU__AI_QUERY__MAX_ROWS=200

# Safety module - independent Feishu app and hazard Bitable.
FEISHU__SAFETY__CREDENTIALS__APP_ID=
FEISHU__SAFETY__CREDENTIALS__APP_SECRET=
FEISHU__SAFETY__BITABLE_APP_TOKEN=
FEISHU__SAFETY__HAZARD_TABLE_ID=

# 安全模块 - AI 模型配置（文本 / 视觉）
SAFETY_AI_TEXT_API_KEY           = your_safety_text_api_key
SAFETY_AI_TEXT_BASE_URL          = https://api.deepseek.com
SAFETY_AI_TEXT_MODEL             = deepseek-v4-flash
SAFETY_AI_VISION_API_KEY         = your_safety_vision_api_key
SAFETY_AI_VISION_BASE_URL        = https://dashscope.aliyuncs.com/compatible-mode/v1
SAFETY_AI_VISION_MODEL           = qwen-vl-max

# 设备模块 - 交互机器人
FEISHU__EQUIPMENT__WS_ENABLED=false
FEISHU__EQUIPMENT__CREDENTIALS__APP_ID=
FEISHU__EQUIPMENT__CREDENTIALS__APP_SECRET=

# Aily
FEISHU__AILY_APP_ID=your-aily-app-id

# AI
MOONSHOT_API_KEY=your-moonshot-api-key
AI_MODEL=kimi-k2.5

# MinIO / S3 对象存储（Docker 部署时启用，本地开发可关闭）
MINIO_ENABLED=false
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PREFIX=dazah
MINIO_SECURE=false

# MCP AI Agent API Keys (comma separated, for service-to-service authentication)
MCP_AGENT_API_KEYS=
