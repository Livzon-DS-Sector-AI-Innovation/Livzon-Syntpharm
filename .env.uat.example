# 个人开发连接 UAT 时不使用本文件；本文件是服务器上 .env.uat 的模板。
# .env.uat 含真实密钥，禁止提交（已在 .gitignore 忽略）。
#
# 服务器上的生成步骤:
#   cp .env.example .env.uat && vi .env.uat     # 先取全量变量，再按下面覆盖 UAT 专属值
#
# 下列变量必须显式设置或确认，否则 compose 插值/容器启动会失败。

# ---- UAT 基础设施标识（与 docker-compose.uat-infra.yml 的默认值对应）----
POSTGRES_DB=erp_uat
POSTGRES_USER=erp_uat_user
POSTGRES_PASSWORD=<从团队获取>
# 容器内通过 compose 内容器名访问（uat-net），不要写 localhost
DATABASE_URL=postgresql+asyncpg://erp_uat_user:<同一上面的密码>@uat-postgres:5432/erp_uat

REDIS_PASSWORD=<从团队获取>
REDIS_URL=redis://:<同一上面的密码>@uat-redis:6379/0

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<从团队获取>
MINIO_ENDPOINT=uat-minio:9000
MINIO_ENABLED=true

# ---- 应用身份 ----
# APP_ENV 用 uat：既不是 production（保留 /docs、不强制文件日志），也不落入 test/e2e 分支
APP_ENV=uat
DEBUG=false
SECRET_KEY=<随机生成的强密钥>
LLM_ENCRYPTION_KEY=<随机生成的强密钥，不入库不入 Git>

# compose 的 environment 段会覆盖 DATABASE_URL/REDIS_URL 的宿主端口写法，
# 以下为 backend 直连容器网络时的取值（保持服务名，勿写 IP）
EDBO_SERVICE_URL=http://edbo-service:8000
API_BASE_URL=http://backend:8000
FRONTEND_URL=http://8.138.204.232

# ---- 飞书凭证 / 多维表格 / AI 模型等 ----
# 其余变量与 .env.example 一一对应，按 UAT 所用的飞书应用与表 ID 填写:
#   FEISHU__PLATFORM__APP_ID / FEISHU__PLATFORM__APP_SECRET
#   FEISHU__HR_BITABLE__* / FEISHU__SAFETY__* / FEISHU__ENERGY__* ...
#   SAFETY_AI_TEXT_API_KEY / SAFETY_AI_VISION_API_KEY / AI_API_KEY / MINIMAX_API_KEY
# 注意: UAT 应使用独立的一套飞书应用与多维表格，避免与 test 环境互相写同一张表。

# ---- 启动开关（UAT 建议保持关闭，按需打开）----
FEISHU__PLATFORM__WS_ENABLED=false
FEISHU__EQUIPMENT__WS_ENABLED=false
LIVZON_FEISHU_CARD_CALLBACK_WS_ENABLED=false
ENERGY_AUTO_COLLECT_ENABLED=false
ENERGY_BITABLE_AUTO_SYNC_ENABLED=false
MAINTENANCE_PLAN_AUTO_ENABLED=false
