# 本地开发环境配置模板（docker-compose.yml + docker-compose.dev.yml）
#
# 使用方法:
#   1. 复制本文件: cp .env.dev.example .env
#      （或直接跑 bash scripts/dev.sh，会自动复制）
#   2. 按需填写飞书凭证 / AI API Keys（留空则对应功能不可用）
#   3. 启动: bash scripts/dev.sh
#
# 说明:
#   - 基础设施（PostgreSQL/Redis/MinIO/EDBO）全部在本地容器运行，数据落在
#     ./postgres-data、./redis-data、./minio-data，与 UAT 完全隔离
#   - up 时自动执行数据库迁移（backend 等待 migrate 完成）
#   - 首次启动后 scripts/dev.sh 会自动写入模块设置种子数据；
#     管理员账号需填写下方 BOOTSTRAP_ADMIN_USERNAME/PASSWORD 后重启 backend
#   - 重置本地数据: docker compose -f docker-compose.yml -f docker-compose.dev.yml down
#     && rm -rf postgres-data redis-data minio-data
#   - 生产环境请使用 .env.example（SECRET_KEY/密钥等必须修改）

# App
APP_NAME=dazah-backend
APP_ENV=development
DEBUG=true
SECRET_KEY=local-dev-secret-key
ENCRYPTION_KEY=

# Database（本地容器，服务名 postgres）
POSTGRES_DB=erp
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_dev_pwd
DATABASE_URL=postgresql+asyncpg://erp_user:erp_dev_pwd@postgres:5432/erp

# Redis（本地容器）
REDIS_URL=redis://erp-redis:6379/0

# JWT
JWT_EXPIRE_SECONDS=86400

# Audit
AUDIT_RETENTION_DAYS=7
# 审计日志过期清理任务开关（每天 04:00，可在系统运维里临时关闭）
AUDIT_CLEANUP_ENABLED=true

# 登录失败锁定策略（连续失败达到次数后锁定，时长单位秒；默认 5 次 / 900 秒）
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# Feishu SSO (Platform app — SSO, org sync, IM, shared Bitable)
# 本地开发不使用飞书功能可全部留空
FEISHU__PLATFORM__APP_ID=
FEISHU__PLATFORM__APP_SECRET=
FEISHU__PLATFORM__SCOPES=contact:contact.base:readonly contact:user.base:readonly
FEISHU__PLATFORM__WS_ENABLED=false
FRONTEND_URL=http://localhost:3000

# Feishu 组织架构同步
FEISHU__PLATFORM__SYNC_ROOT_DEPT_ID=
FEISHU__PLATFORM__SYNC_MEMBER_DEPT_ID=

# Feishu 部门 Chat
FEISHU__PLATFORM__EQUIPMENT_DEPT_ID=
FEISHU__PLATFORM__EQUIPMENT_CHAT_ID=
FEISHU__PLATFORM__SAFETY_CHAT_ID=

# Feishu 设备模块交互机器人
FEISHU__EQUIPMENT__CREDENTIALS__APP_ID=
FEISHU__EQUIPMENT__CREDENTIALS__APP_SECRET=
FEISHU__EQUIPMENT__WS_ENABLED=false

# Upload
UPLOAD_DIR=./uploads
# 历史版本附件兜底目录（旧附件曾落在 /tmp 下；置空关闭兜底）
LEGACY_UPLOAD_DIR=/tmp/dazah_uploads
MAX_UPLOAD_SIZE_MB=10

# Feishu Bitable — HR 模块
FEISHU__HR_BITABLE__APP_TOKEN=
FEISHU__HR_BITABLE__EMPLOYEE_TABLE_ID=
FEISHU__HR_BITABLE__DEPARTMENT_TABLE_ID=
FEISHU__HR_BITABLE__OFFBOARDING_TABLE_ID=
FEISHU__HR_BITABLE__ONBOARDING_TABLE_ID=
FEISHU__HR_BITABLE__DEPARTURE_TABLE_ID=
FEISHU__HR_BITABLE__APPROVAL_TABLE_ID=

# Feishu Bitable — Product 模块
FEISHU__PRODUCT__BITABLE_APP_TOKEN=
FEISHU__PRODUCT__BITABLE_TABLE_ID=

# Feishu AI Query
FEISHU__AI_QUERY__TABLES=
FEISHU__AI_QUERY__MAX_ROWS=200

# Feishu Training Bitable
FEISHU__TRAINING__BITABLE_TRAINING_NOTIFICATION_APP_TOKEN=
FEISHU__TRAINING__BITABLE_TRAINING_NOTIFICATION_TABLE_ID=

# AI — HR 离职分析
MOONSHOT_API_KEY=
AI_MODEL=kimi-k2.5

# Safety Module — 独立飞书应用 + 隐患登记多维表格
FEISHU__SAFETY__CREDENTIALS__APP_ID=
FEISHU__SAFETY__CREDENTIALS__APP_SECRET=
FEISHU__SAFETY__BITABLE_APP_TOKEN=
FEISHU__SAFETY__HAZARD_TABLE_ID=

# Safety Module — AI Models (文本/视觉)
SAFETY_AI_TEXT_API_KEY=
SAFETY_AI_TEXT_BASE_URL=https://api.deepseek.com
SAFETY_AI_TEXT_MODEL=deepseek-v4-flash
SAFETY_AI_VISION_API_KEY=
SAFETY_AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SAFETY_AI_VISION_MODEL=qwen-vl-max

# MinIO / S3 Object Storage（本地容器，服务名 minio；控制台 http://localhost:9001）
MINIO_ENABLED=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PREFIX=dazah
MINIO_SECURE=false

# API
API_V1_PREFIX=/api/v1
API_BASE_URL=http://backend:8000

# MCP AI Agent API Keys
MCP_AGENT_API_KEYS=

# Crawler (法规追踪爬虫)
CRAWLER_HEADLESS=true
CRAWLER_BROWSERS_PATH=

# EDBO Service URL（本地容器）
EDBO_SERVICE_URL=http://edbo-service:8000

# LLM Configuration
LLM_ENCRYPTION_KEY=local-dev-llm-encryption-key
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Feishu Bitable — HR 模块 (新增: 候选人)
FEISHU__HR_BITABLE__CANDIDATE_APP_TOKEN=
FEISHU__HR_BITABLE__CANDIDATE_TABLE_ID=

# Feishu Vehicle 模块
FEISHU__VEHICLE__CREDENTIALS__APP_ID=
FEISHU__VEHICLE__CREDENTIALS__APP_SECRET=
FEISHU__VEHICLE__BITABLE_REQUEST_APP_TOKEN=
FEISHU__VEHICLE__BITABLE_REQUEST_TABLE_ID=

# Feishu Training 模块 (新增: 独立应用凭证 + 物料BOM)
FEISHU__TRAINING__CREDENTIALS__APP_ID=
FEISHU__TRAINING__CREDENTIALS__APP_SECRET=
FEISHU__TRAINING__BITABLE_MATERIAL_BOM_APP_TOKEN=
FEISHU__TRAINING__BITABLE_MATERIAL_BOM_TABLE_ID=

# AI (通用)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_VISION_MODEL=gpt-4o

# Storage
STORAGE_ROOT=./storage

# Feishu Energy 模块
FEISHU__ENERGY__APP_TOKEN=
FEISHU__ENERGY__WORKSHOP_TABLE_ID=
FEISHU__ENERGY__MONTHLY_TABLE_ID=
FEISHU__ENERGY__ALERT_APP_TOKEN=
# Energy module runtime config（本地默认关闭，避免操作真实飞书表格）
ENERGY_AUTO_COLLECT_ENABLED=false
ENERGY_BITABLE_AUTO_SYNC_ENABLED=false
ENERGY_BITABLE_SYNC_HOUR=17
FEISHU__ENERGY__DAILY_SYNC_HOUR=17

# Feishu Product 模块 (新增: 独立应用凭证 + 产量记录)
FEISHU__PRODUCT__CREDENTIALS__APP_ID=
FEISHU__PRODUCT__CREDENTIALS__APP_SECRET=
FEISHU__PRODUCT__BITABLE_OUTPUT_APP_TOKEN=
FEISHU__PRODUCT__BITABLE_OUTPUT_TABLE_ID=

# AI — MiniMax (quality module AI features)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# Bootstrap local users（可选；首次启动后填写并重启 backend 即可创建账号）
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_USER_USERNAME=
BOOTSTRAP_USER_PASSWORD=
BOOTSTRAP_USER_NAME=普通用户
BOOTSTRAP_USER_EMAIL=
# 启动时是否强制把引导账号密码回灌为上面的值（默认 false）
BOOTSTRAP_ADMIN_FORCE_RESET=false
SSO_ADMIN_IDENTIFIERS=

# Livzon Feishu Card Callback WebSocket
LIVZON_FEISHU_CARD_CALLBACK_WS_ENABLED=false

# 权限体系（本地默认只登录、不跑绑定兜底；开 true 前先确认各模块绑定已登记完）
PERMISSION_ENFORCE_ENABLED=false
PERMISSION_ENFORCE_MODULES=

# HR 飞书「审批完成」事件回调校验凭据（留空则回调被拒绝）
HR_FEISHU_APPROVAL_ENCRYPT_KEY=
HR_FEISHU_APPROVAL_VERIFICATION_TOKEN=

# Livzon Agent (Hermes)
HERMES_AGENT_URL=
HERMES_AGENT_TOKEN=

# Font & LibreOffice paths (for PDF/report generation in Docker)
CJK_FONT_PATH=
SOFFICE_PATH=

# Equipment maintenance plan scheduler（本地默认关闭）
MAINTENANCE_PLAN_AUTO_ENABLED=false

# Agent (Hermes / Livzon)
AGENT_TOOL_TOKEN=
AGENT_LLM_PROXY_TOKEN=
AGENT_INTERNAL_API_TOKEN=
AGENT_WRITE_CONFIRM_TTL_SECONDS=300
AGENT_HERMES_TIMEOUT_SECONDS=210
AGENT_INTERNAL_API_TIMEOUT_SECONDS=120
