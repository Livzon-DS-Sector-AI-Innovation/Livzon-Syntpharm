# ============================================================
# 个人开发环境变量配置
# 复制为 .env.local 并填入实际值
# cp .env.local.example .env.local
# ============================================================

# 测试服务器地址（固定值，内网IP）
TEST_SERVER_IP=172.17.62.101

# 连接测试服务器的基础设施
# 密码需从团队获取（与测试服务器 .env.test 中一致）
TEST_DATABASE_URL=postgresql+asyncpg://erp_test_user:<密码>@172.17.62.101:15432/erp_test
TEST_REDIS_URL=redis://:<密码>@172.17.62.101:16379/0
TEST_MINIO_ENDPOINT=172.17.62.101:19000
TEST_EDBO_SERVICE_URL=http://172.17.62.101:18001
